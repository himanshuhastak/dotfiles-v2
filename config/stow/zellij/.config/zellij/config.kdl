// Catppuccin Mocha + community plugins (zsm, zjstatus, monocle).
// WASM binaries: var/vendor/zellij-plugins/ (install/steps/install-zellij-plugins.sh)
// Symlinked to ~/.config/zellij/plugins/ on stow.

theme "catppuccin-mocha"
default_shell "zsh"
default_layout "default"
show_startup_tips false
pane_frames true
mouse_mode true
copy_on_select true

plugins {
    // Built-ins (keep defaults; zjstatus layout replaces tab-bar + status-bar UI)
    tab-bar          location="zellij:tab-bar"
    status-bar       location="zellij:status-bar"
    strider          location="zellij:strider"
    compact-bar      location="zellij:compact-bar"
    session-manager  location="zellij:session-manager"
    welcome-screen   location="zellij:session-manager" { welcome_screen true }
    filepicker       location="zellij:strider" { cwd "/" }
    configuration    location="zellij:configuration"
    plugin-manager   location="zellij:plugin-manager"

    // Community (vendored .wasm)
    zsm      location="file:~/.config/zellij/plugins/zsm.wasm"
    monocle  location="file:~/.config/zellij/plugins/monocle.wasm"
    zjstatus location="file:~/.config/zellij/plugins/zjstatus.wasm"
    zjframes location="file:~/.config/zellij/plugins/zjframes.wasm"
}

// zjframes: smart pane frames (pairs with zjstatus).
load_plugins {
    zjframes {
        hide_frame_for_single_pane       "true"
        hide_frame_except_for_search     "true"
        hide_frame_except_for_scroll     "true"
        hide_frame_except_for_fullscreen "true"
    }
}

keybinds {
    shared_except "locked" {
        // Zoxide session manager (needs zoxide + RunCommands permission).
        bind "Alt z" {
            LaunchOrFocusPlugin "zsm" {
                floating true
                move_to_focused_tab true
                default_layout "development"
                show_resurrectable_sessions true
            }
            SwitchToMode "Normal"
        }
        // Fuzzy finder for file names / contents in scrollback and workspace.
        bind "F1" {
            LaunchOrFocusPlugin "monocle" {
                floating true
            }
            SwitchToMode "Normal"
        }
    }
}
