# Dotfiles-managed SSH client config.
#
# Load order (OpenSSH: first matching value wins per option):
#   1. config.d/local.conf   — symlink to local/profile/ssh.local
#   2. github / gitlab below
#   3. config.d/dotfiles.conf — Host * defaults (last)
#
# Edit SSH hosts in:  local/profile/ssh.local
# Apply:               dotfiles ssh-sync

Include config.d/local.conf

# ---------------------------------------------------------------------------
# Git hosting — User git (before Host * defaults)
# ---------------------------------------------------------------------------
Host github.com
  HostName ssh.github.com
  Port 443
  User git

Host gitlab.com
  HostName altssh.gitlab.com
  Port 443
  User git

Include config.d/dotfiles.conf
