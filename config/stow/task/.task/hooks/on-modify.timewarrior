#!/usr/bin/env python3
###############################################################################
# Taskwarrior -> Timewarrior bridge hook (on-modify).
# Starts/stops timewarrior tracking as tasks are started/stopped/completed.
###############################################################################
import json
import subprocess
import sys


def main():
    old = json.loads(sys.stdin.readline())
    new = json.loads(sys.stdin.readline())
    print(json.dumps(new))

    started = "start" in new and "start" not in old
    stopped = ("start" in old and "start" not in new) or (
        "start" in old and new.get("status") == "completed"
    )

    def tags(task):
        out = [task.get("description", "")]
        if "project" in task:
            out.append(task["project"])
        out.extend(task.get("tags", []))
        return [t for t in out if t]

    if started:
        subprocess.run(["timew", "start"] + tags(new), check=False)
    elif stopped:
        subprocess.run(["timew", "stop"], check=False)


if __name__ == "__main__":
    main()
