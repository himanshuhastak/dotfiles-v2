# config/shell/shrc — portable interactive bash base (optional).
# Login shell is zsh. Sourced from ~/.bashrc only if you start bash.

if [ -z "${DOTFILES_DIR:-}" ]; then
  if [ -r "${BASH_SOURCE[0]:-}" ]; then
    _dfself="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    . "$(cd "$(dirname "$_dfself")" && pwd)/resolve-dotfiles-dir.sh" "$_dfself"
    unset _dfself
  else
    . "${HOME}/.zshenv" 2>/dev/null || true
    if [ -z "${DOTFILES_DIR:-}" ] && [ -e "$HOME/.zshenv" ]; then
      _dfself="$(readlink -f "$HOME/.zshenv" 2>/dev/null || echo "$HOME/.zshenv")"
      . "$(dirname "$_dfself")/../../config/shell/resolve-dotfiles-dir.sh" "$_dfself" 2>/dev/null || true
      unset _dfself
    fi
  fi
fi
: "${DOTFILES_DIR:?DOTFILES_DIR not set}"

_sh="$DOTFILES_DIR/config/shell"
[ -r "$_sh/loader.sh" ]     && . "$_sh/loader.sh"
[ -r "$_sh/env.sh" ]         && . "$_sh/env.sh"
[ -r "$_sh/functions.sh" ]   && . "$_sh/functions.sh"
[ -r "$_sh/aliases.sh" ]     && . "$_sh/aliases.sh"
unset _sh

if [ -n "${BASH_VERSION:-}" ]; then
  _load_file "$DOTFILES_DIR/config/shell/tools/init.sh"
  for _f in "$DOTFILES_DIR/config/shell/tools"/*.sh; do
    [ -f "$_f" ] || continue
    [ "${_f##*/}" = init.sh ] && continue
    _load_file "$_f"
  done
  unset _f
  _load_profile tools
fi

_load_profile aliases
