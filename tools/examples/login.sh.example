# local/profile/login.sh — runs on REMOTE after ssh login (see .zprofile).
#
# Good for: module load, vncstart, login-only exports.
# Not for: SSH tunnels (use ssh.local LocalForward) or secrets (dotfiles secrets).
#
# Client-side after connect (Windows): LocalCommand in ssh.local — see ssh.local.example

# module load gcc/12

