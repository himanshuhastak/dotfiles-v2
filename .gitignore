# Generated, variable data — all under var/ (self-owned; never committed):
#   var/tools/   built/downloaded CLI binaries, compiled bash/zsh, venvs
#   var/vendor/  sheldon plugin clones, zellij WASM plugins, lockfile artifacts
#   var/cache/   transient download/build cache
#   var/work/    generated stow package for ~/Work mount links (not in config/stow/)
/var/

# Compiled zsh bytecode (produced by `dotfiles compile`).
*.zwc

# Python bytecode (produced when running dotfiles-tools).
__pycache__/
*.py[cod]

# Logs
/run.log
/var/run.log

# Accidental empty junk from shell redirects or leaked GNU parallel joblogs during install.
/Found
/Installing

# Legacy generated locations (pre-restructure; ignored during migration).
/.tools/
/vendor/
/.cache/

/config/stow/zellij/.config/zellij/plugins/*.wasm
*.swp
*~
.DS_Store

# Per-user overrides (gitignored). Only profile/.gitignore is tracked.
local/**
!local/profile/
!local/profile/.gitignore

# Directory UUID stamps (must not be stowed into ~/).
.uuid
