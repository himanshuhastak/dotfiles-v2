# local/ — per-user overrides (only profile.example/ templates are tracked).
#
# Layout:
#   profile/<name>.sh         real config (gitignored; may be symlinks)
#   profile.example/*.example templates to copy from
#   disabled                  module toggles (dotfiles disable; gitignored)
#
# Stable semantic files (load order is fixed by the framework):
#   secrets.sh   every shell (env, secrets, PATH)
#   login.sh     login zsh only
#   aliases.sh   interactive aliases
#   tools.sh     per-tool hooks (after compinit)
#   company.sh   work / cluster env (interactive last)
#
# Quick start:
#   mkdir -p local/profile
#   cp local/profile.example/*.example local/profile/
#   for f in local/profile/*.example; do mv "$f" "${f%.example}"; done
#   exec zsh
#
# company.sh (cluster / LSF): keep the real file outside the repo so rsync
# never overwrites it, then symlink:
#   vim ~/bin/gfs.sh          # your work env (see profile.example/company.sh.example)
#   ln -sf ~/bin/gfs.sh local/profile/company.sh
#
# Toggle a file:  dotfiles disable company   (name = basename without .sh)
# Keep drop-ins SILENT (no echo).
