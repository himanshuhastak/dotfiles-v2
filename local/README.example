# local/ — per-user overrides (templates: profile.example/, gfs.example/).
#
# Layout:
#   profile/<name>.sh         shell profile drop-ins (gitignored; often symlinks)
#   gfs.example/              template for ~/bin/gfs/ (company + mount.lst)
#   work/                       generated by dotfiles work-stow (gitignored)
#   disabled                    module toggles (dotfiles disable; gitignored)
#
# ~/bin/gfs — one folder outside the repo for machine-specific work setup:
#   company.sh    cluster / LSF shell env
#   mount.lst     path:shortname lines for ~/Work (scratch, tmp, …)
#
# Quick start:
#   mkdir -p ~/bin/gfs
#   cp local/gfs.example/* ~/bin/gfs/
#   vim ~/bin/gfs/company.sh ~/bin/gfs/mount.lst
#   ln -sf ~/bin/gfs/company.sh local/profile/company.sh
#   dotfiles work-stow
#   exec zsh
