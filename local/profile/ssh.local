# Machine-specific SSH — symlinked to ~/.ssh/config.d/local.conf via dotfiles ssh-sync.
# Copy/sync this file to each client (Windows + Linux) via dotfiles git.
#
# LocalForward: active while THIS ssh session is open (no extra script).
# Each work host gets its own local port so parallel ssh from the same machine works.
# Different machines (laptop + desktop) can both use 5902 — conflict is only on one host.

Host arctest5
  HostName 10.207.1.45
  # LocalForward 5903 127.0.0.1:5901

Host res-vm-rhel
  HostName 10.207.13.141
  LocalForward 5902 127.0.0.1:5902

# Add hosts — increment local port (5904, 5905, …) for parallel tunnels on one client:
# Host work-example
#   HostName work-example.example.internal
#   LocalForward 5904 127.0.0.1:5902
