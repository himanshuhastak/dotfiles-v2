# ~/bin/gfs — machine-specific work env (outside the repo).
#
#   company.sh   shell profile (symlink: local/profile/company.sh -> ~/bin/gfs/company.sh)
#   mount.lst    ~/Work disk links (read by dotfiles work-stow)
#
# Quick start (from repo root):
#   mkdir -p ~/bin/gfs
#   cp local/gfs.example/* ~/bin/gfs/
#   vim ~/bin/gfs/company.sh ~/bin/gfs/mount.lst
#   ln -sf ~/bin/gfs/company.sh local/profile/company.sh
#   dotfiles work-stow
#
# mount.lst format:  /path/to/disk:shortname
#   /scratch/$USER:scratch
#   /tmp:tmp
