#!/usr/bin/env bash
# bin/dotfiles-tools — tool management and health checks
# Enhancements: doctor-tools, verify versions, check dependencies, cleanup caches
set -uo pipefail

self="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-${self%/bin}}"
MANIFEST="$DOTFILES_DIR/config/tools.toml"
LOCK_FILE="$DOTFILES_DIR/config/tools.lock"
BIN="$DOTFILES_DIR/var/tools/bin"

c_on=$'\033[1;32m'; c_off=$'\033[1;33m'; c_b=$'\033[1;34m'; c_r=$'\033[0m'
[ -t 1 ] || { c_on=; c_off=; c_b=; c_r=; }

log()  { printf '%s==>\033[0m %s\n' "$c_b" "$*"; }
ok()   { printf '%s✓\033[0m %s\n' "$c_on" "$*"; }
warn() { printf '%s!\033[0m %s\n' "$c_off" "$*" >&2; }
die()  { printf '%s✘\033[0m %s\n' "$c_off" "$*" >&2; exit 1; }

# Parse tools.toml and extract tool info
_parse_tools() {
  [ -r "$MANIFEST" ] || return 1
  awk '
    /^\[\[tool\]\]/ {
      if (name != "") print name "|" repo "|" desc
      name = repo = desc = ""
      next
    }
    /^name[[:space:]]*=/ {
      match($0, /"([^"]+)"/, a); name = a[1]
    }
    /^repo[[:space:]]*=/ {
      match($0, /"([^"]+)"/, a); repo = a[1]
    }
    /^description[[:space:]]*=/ {
      match($0, /"([^"]+)"/, a); desc = a[1]
    }
    END {
      if (name != "") print name "|" repo "|" desc
    }
  ' "$MANIFEST"
}

# Tool health report
cmd_doctor_tools() {
  log "Tool Health Check"
  local total=0 healthy=0 issues=0

  _parse_tools | while IFS='|' read -r name repo desc; do
    [ -z "$name" ] && continue
    total=$((total + 1))
    
    printf '\n%s%s%s\n' "$c_b" "$name" "$c_r"
    [ -n "$desc" ] && printf '  %s\n' "$desc"
    
    # Check binary exists
    if [ -x "$BIN/$name" ] || command -v "$name" >/dev/null 2>&1; then
      ok "Binary found in PATH"
      healthy=$((healthy + 1))
      
      # Try version
      if $name --version >/dev/null 2>&1; then
        local version=$($name --version 2>&1 | head -1)
        printf '  Version: %s\n' "$version"
      fi
    else
      warn "Binary NOT found in PATH"
      issues=$((issues + 1))
      printf '  Suggestion: dotfiles update-tools %s\n' "$name"
    fi
    
    # Check conf.d hook
    if [ -f "$DOTFILES_DIR/config/shell/conf.d"/*"$name"* ] 2>/dev/null; then
      ok "Hook file exists"
    fi
  done

  echo ""
  printf '%s━━━━━━━━━━━━━━━━━━━%s\n' "$c_b" "$c_r"
  printf 'Summary: %d total, %d healthy, %d issues\n' "$total" "$healthy" "$issues"
  [ "$issues" -eq 0 ] && ok "All tools healthy" || warn "$issues tool(s) need attention"
}

# Version check vs manifest
cmd_verify() {
  log "Tool Version Verification"
  [ -f "$LOCK_FILE" ] || { warn "No lock file found ($LOCK_FILE)"; return 1; }
  
  local mismatch=0
  _parse_tools | while IFS='|' read -r name repo desc; do
    [ -z "$name" ] && continue
    
    if command -v "$name" >/dev/null 2>&1; then
      local current_version=$($name --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
      # Would compare with lock file here
      printf '%s: %s\n' "$name" "${current_version:-unknown}"
    fi
  done
}

# Clean caches
cmd_clean_caches() {
  log "Cleaning caches"
  
  local zsh_cache="$HOME/.cache/zsh"
  local dot_cache="$HOME/.cache/dotfiles"
  
  if [ -d "$zsh_cache" ]; then
    local count=$(find "$zsh_cache" -type f -mtime +30 2>/dev/null | wc -l)
    [ "$count" -gt 0 ] && find "$zsh_cache" -type f -mtime +30 -delete && ok "Removed $count stale zsh caches"
  fi
  
  if [ -d "$dot_cache" ]; then
    local count=$(find "$dot_cache" -type f -mtime +7 2>/dev/null | wc -l)
    [ "$count" -gt 0 ] && find "$dot_cache" -type f -mtime +7 -delete && ok "Removed $count stale dotfiles caches"
  fi
  
  ok "Cache cleanup complete"
}

# Check for tool dependencies
cmd_check_deps() {
  log "Tool Dependency Check"
  warn "Dependency tracking not yet implemented in tools.toml"
  warn "See OPTIMIZATION_ROADMAP.md for details"
}

usage() {
  cat <<EOF
${c_b}dotfiles-tools${c_r} — tool management and health checks

Usage: dotfiles-tools <command> [options]

Commands:
  doctor        Show tool health report (default)
  verify        Check tool versions vs lock file
  clean-caches  Remove stale completion/init caches
  check-deps    Verify tool dependencies
  help          Show this help

Examples:
  dotfiles-tools doctor
  dotfiles-tools verify
  dotfiles-tools clean-caches
EOF
}

main() {
  local cmd="${1:-doctor}"
  shift 2>/dev/null || true
  
  case "$cmd" in
    doctor)       cmd_doctor_tools "$@" ;;
    verify)       cmd_verify "$@" ;;
    clean-caches) cmd_clean_caches "$@" ;;
    check-deps)   cmd_check_deps "$@" ;;
    help|-h)      usage ;;
    *)            die "Unknown command: $cmd (try: dotfiles-tools help)" ;;
  esac
}

main "$@"
