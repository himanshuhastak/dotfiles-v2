#!/usr/bin/env bash
# bin/dotfiles-validate — configuration integrity (chezmoi layout)
set -uo pipefail

self="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-${self%/bin}}"
SHELL_DIR="$DOTFILES_DIR/config/shell"
LOCAL_DIR="${DOTFILES_LOCAL:-$DOTFILES_DIR/local}"

c_on=$'\033[1;32m'
c_off=$'\033[1;33m'
c_b=$'\033[1;34m'
c_r=$'\033[0m'
[ -t 1 ] || {
  c_on=
  c_off=
  c_b=
  c_r=
}

ok() { printf '%s✓%s %s\n' "$c_on" "$c_r" "$*"; }
warn() { printf '%s!%s %s\n' "$c_off" "$c_r" "$*" >&2; }

cmd_check_config() {
  local issues=0

  printf '%sConfiguration Validation%s\n\n' "$c_b" "$c_r"

  printf '%sCore Files%s\n' "$c_b" "$c_r"
  local core_files=(
    "config/shell/loader.sh"
    "config/zsh/.zshenv"
    "config/zsh/.zshrc"
    "home/.zshenv.tmpl"
    "bin/dotfiles"
    ".chezmoi.toml"
  )
  for f in "${core_files[@]}"; do
    if [ -r "$DOTFILES_DIR/$f" ]; then
      ok "$f"
    else
      warn "$f NOT FOUND"
      issues=$((issues + 1))
    fi
  done

  printf '\n%sChezmoi / $HOME%s\n' "$c_b" "$c_r"
  if [ -d "$DOTFILES_DIR/home" ]; then
    local n
    n="$(find "$DOTFILES_DIR/home" -type f ! -name '*.tmpl' | wc -l)"
    ok "home/ source tree ($n files)"
  else
    warn "home/ missing"
    issues=$((issues + 1))
  fi
  if [ -f "$HOME/.zshenv" ]; then
    ok "~/.zshenv present"
  else
    warn "~/.zshenv missing — run: dotfiles apply"
    issues=$((issues + 1))
  fi

  printf '\n%sShell Syntax%s\n' "$c_b" "$c_r"
  local syntax_errors=0
  for f in "$SHELL_DIR"/**/*.sh "$SHELL_DIR"/**/*.zsh; do
    [ -r "$f" ] || continue
    case "$f" in
      *.sh) bash -n "$f" 2>/dev/null || {
        warn "bash syntax error in $f"
        syntax_errors=$((syntax_errors + 1))
      } ;;
      *.zsh) zsh -n "$f" 2>/dev/null || {
        warn "zsh syntax error in $f"
        syntax_errors=$((syntax_errors + 1))
      } ;;
    esac
  done
  [ "$syntax_errors" -eq 0 ] && ok "shell framework syntax OK" || warn "$syntax_errors syntax error(s)"

  printf '\n%sProfiles%s\n' "$c_b" "$c_r"
  local profile_count=0
  for f in "$LOCAL_DIR/profile"/*; do
    [ -f "$f" ] || continue
    ok "${f##*/}"
    profile_count=$((profile_count + 1))
  done
  [ "$profile_count" -gt 0 ] || warn "no local/profile files yet (optional)"

  printf '\n%s━━━━━━━━━━━━━━━━━━━%s\n' "$c_b" "$c_r"
  [ "$issues" -eq 0 ] && ok "Configuration valid" || warn "$issues issue(s)"
}

usage() {
  cat <<EOF
${c_b}dotfiles-validate${c_r} — chezmoi configuration checks

Usage: dotfiles-validate [config|help]
EOF
}

main() {
  case "${1:-config}" in
    config | all) cmd_check_config ;;
    help) usage ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
