#!/usr/bin/env bash
# bin/dotfiles-validate — comprehensive configuration validation
# Checks paths, symlinks, syntax, and integrity

set -uo pipefail

self="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-${self%/bin}}"
SHELL_DIR="$DOTFILES_DIR/config/shell"
LOCAL_DIR="${DOTFILES_LOCAL:-$DOTFILES_DIR/local}"

c_on=$'\033[1;32m'; c_off=$'\033[1;33m'; c_b=$'\033[1;34m'; c_r=$'\033[0m'
[ -t 1 ] || { c_on=; c_off=; c_b=; c_r=; }

ok()   { printf '%s✓%s %s\n' "$c_on" "$c_r" "$*"; }
warn() { printf '%s!%s %s\n' "$c_off" "$c_r" "$*" >&2; }
die()  { printf '%s✘%s %s\n' "$c_off" "$c_r" "$*" >&2; exit 1; }

cmd_check_config() {
  local issues=0
  
  printf '%sConfiguration Validation%s\n\n' "$c_b" "$c_r"
  
  # 1. Check core files exist
  printf '%sCore Files%s\n' "$c_b" "$c_r"
  local core_files=(
    "config/shell/loader.sh"
    "config/zsh/.zshenv"
    "config/zsh/.zshrc"
    "bin/dotfiles"
  )
  for f in "${core_files[@]}"; do
    if [ -r "$DOTFILES_DIR/$f" ]; then
      ok "$f"
    else
      warn "$f NOT FOUND"
      issues=$((issues + 1))
    fi
  done
  
  # 2. Check symlinks
  printf '\n%sSymlinks%s\n' "$c_b" "$c_r"
  if [ -L "$HOME/.zshenv" ]; then
    local target=$(readlink "$HOME/.zshenv" 2>/dev/null || true)
    ok "~/.zshenv -> $target"
  else
    warn "~/.zshenv not symlinked"
    issues=$((issues + 1))
  fi
  
  # 3. Check stow packages
  printf '\n%sStow Packages%s\n' "$c_b" "$c_r"
  local pkg_count=$(find "$DOTFILES_DIR/config/stow" -mindepth 1 -maxdepth 1 -type d | wc -l)
  ok "$pkg_count stow packages configured"
  
  # 4. Check shell syntax
  printf '\n%sShell Syntax%s\n' "$c_b" "$c_r"
  local syntax_errors=0
  
  for f in "$SHELL_DIR"/**/*.sh "$SHELL_DIR"/**/*.zsh; do
    [ -r "$f" ] || continue
    
    case "$f" in
      *.sh)
        bash -n "$f" 2>/dev/null || { warn "bash syntax error in $f"; syntax_errors=$((syntax_errors+1)); }
        ;;
      *.zsh)
        zsh -n "$f" 2>/dev/null || { warn "zsh syntax error in $f"; syntax_errors=$((syntax_errors+1)); }
        ;;
    esac
  done
  
  [ "$syntax_errors" -eq 0 ] && ok "All shell scripts pass syntax check" || \
    warn "$syntax_errors file(s) have syntax errors"
  
  # 5. Check profiles
  printf '\n%sProfiles%s\n' "$c_b" "$c_r"
  local profile_files=(
    "$LOCAL_DIR/profile/local.sh"
    "$LOCAL_DIR/profile/aliases.sh"
    "$LOCAL_DIR/profile/tools.sh"
    "$LOCAL_DIR/profile/company.sh"
  )
  
  local profile_count=0
  for f in "${profile_files[@]}"; do
    if [ -r "$f" ]; then
      ok "$(basename $f)"
      profile_count=$((profile_count + 1))
    fi
  done
  [ "$profile_count" -gt 0 ] || warn "No user profiles configured"
  
  # 6. Summary
  printf '\n%s━━━━━━━━━━━━━━━━━━━%s\n' "$c_b" "$c_r"
  if [ "$issues" -eq 0 ]; then
    ok "Configuration valid: 0 issues found"
  else
    warn "Configuration has $issues issue(s)"
  fi
}

usage() {
  cat <<EOF
${c_b}dotfiles-validate${c_r} — comprehensive configuration validation

Usage: dotfiles-validate [command]

Commands:
  config       Check configuration integrity
  syntax       Verify shell script syntax
  symlinks     Check all dotfiles symlinks
  all          Run all checks (default)
  help         Show this help
EOF
}

main() {
  local cmd="${1:-all}"
  case "$cmd" in
    config|all) cmd_check_config ;;
    help)       usage ;;
    *)          usage; exit 1 ;;
  esac
}

main "$@"
