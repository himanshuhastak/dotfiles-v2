#!/usr/bin/env bash
# dotfiles — manage this dotfiles framework. See `dotfiles help` or `man dotfiles`.
#
# Toggles are stored one-per-line in $DOTFILES_LOCAL/disabled and folded into
# $DOTFILES_DISABLE by config/shell/core/00-env.sh on shell startup.
set -uo pipefail

# --- locate the repo (prefer the env var; else derive from this script) ------
self="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-${self%/bin}}"
SHELL_DIR="$DOTFILES_DIR/config/shell"
STOW_DIR="$DOTFILES_DIR/config/stow"
LOCAL_DIR="${DOTFILES_LOCAL:-$DOTFILES_DIR/local}"
DISABLED_FILE="$LOCAL_DIR/disabled"

c_on=$'\033[1;32m'; c_off=$'\033[1;33m'; c_b=$'\033[1;34m'; c_r=$'\033[0m'
[ -t 1 ] || { c_on=; c_off=; c_b=; c_r=; }

die() { printf '%s\n' "dotfiles: $*" >&2; exit 1; }

# --- single source of truth for subcommands (NAME<TAB>SUMMARY) ---------------
# Used to render `dotfiles help` AND to generate man/dotfiles.1 (so they can
# never drift apart). Keep one line per subcommand.
_commands() {
  cat <<'EOF'
list	list modules and their on/off state
enable <name>...	re-enable module(s) (persists)
disable <name>...	disable module(s) (persists)
reload	recompile, then re-exec the current shell
update	git pull --ff-only, then re-run install.sh
compile	byte-compile the zsh framework (.zwc) for faster startup
stow [--if-needed]	(re)create the dotfiles symlinks via stow
doctor	health checks (paths, symlinks, core tools, var/)
check	lint scripts (shellcheck .sh + zsh -n/zshellcheck .zsh + actionlint + editorconfig)
audit	scan the working tree for secrets (betterleaks)
test	run the bats smoke tests in test/
bench [N]	benchmark interactive zsh startup (N runs, default 10)
profile	start a zsh that prints a zprof startup timing report
doc [man]	regenerate the man page from this help
help	show this help
EOF
}

# module base name = filename minus an NN- prefix and the extension
_modname() { local b=${1##*/}; b=${b%.*}; case "$b" in [0-9][0-9]-*) b=${b#??-} ;; esac; printf '%s\n' "$b"; }

_is_disabled() {
  [ -r "$DISABLED_FILE" ] || return 1
  grep -qxF "$1" "$DISABLED_FILE"
}

cmd_list() {
  local d f name profile_dir="$LOCAL_DIR/profile"
  for d in "$SHELL_DIR/core" "$SHELL_DIR/zsh" "$SHELL_DIR/conf.d"; do
    [ -d "$d" ] || continue
    printf '%s%s%s\n' "$c_b" "${d#"$DOTFILES_DIR/"}" "$c_r"
    for f in "$d"/*.sh "$d"/*.zsh; do
      [ -r "$f" ] || continue
      case "${f##*/}" in *.example|README*|disabled) continue ;; esac
      name="$(_modname "$f")"
      if _is_disabled "$name"; then
        printf '  %soff%s  %s\n' "$c_off" "$c_r" "$name"
      else
        printf '  %s on%s  %s\n' "$c_on" "$c_r" "$name"
      fi
    done
  done
  if [ -d "$profile_dir" ]; then
    printf '%s%s%s\n' "$c_b" "${profile_dir#"$DOTFILES_DIR/"}" "$c_r"
    for f in "$profile_dir"/*.sh; do
      [ -r "$f" ] || continue
      name="$(_modname "$f")"
      if _is_disabled "$name"; then
        printf '  %soff%s  %s\n' "$c_off" "$c_r" "$name"
      else
        printf '  %s on%s  %s\n' "$c_on" "$c_r" "$name"
      fi
    done
  fi
  [ -s "$DISABLED_FILE" ] && printf '\ntoggles file: %s\n' "$DISABLED_FILE"
  return 0
}

cmd_disable() {
  [ "$#" -gt 0 ] || die "disable: need a module name (see: dotfiles list)"
  mkdir -p "$LOCAL_DIR"; touch "$DISABLED_FILE"
  local m
  for m in "$@"; do
    if grep -qxF "$m" "$DISABLED_FILE"; then
      echo "already disabled: $m"
    else
      printf '%s\n' "$m" >> "$DISABLED_FILE"
      echo "disabled: $m"
    fi
  done
  echo "Run 'dotfiles reload' to apply."
}

cmd_enable() {
  [ "$#" -gt 0 ] || die "enable: need a module name"
  [ -r "$DISABLED_FILE" ] || { echo "nothing disabled"; return 0; }
  local m tmp; tmp="$(mktemp)"
  for m in "$@"; do
    grep -vxF "$m" "$DISABLED_FILE" > "$tmp" && mv "$tmp" "$DISABLED_FILE"
    echo "enabled: $m"
  done
  rm -f "$tmp" 2>/dev/null || true
  echo "Run 'dotfiles reload' to apply."
}

cmd_reload() {
  command -v dotfiles >/dev/null 2>&1 && dotfiles compile >/dev/null 2>&1 || true
  exec "${SHELL:-zsh}" -l
}

cmd_compile() {
  command -v zsh >/dev/null 2>&1 || die "compile: zsh not found"
  zsh -f -c '
    dirs=( "'"$SHELL_DIR"'"/zsh "'"$SHELL_DIR"'"/conf.d "'"$LOCAL_DIR"'"/profile )
    n=0
    for d in $dirs; do
      [[ -d $d ]] || continue
      for f in $d/*.zsh(N) $d/*.sh(N); do
        [[ -r $f ]] || continue
        if [[ ! -e $f.zwc || $f -nt $f.zwc ]]; then
          zcompile -- $f 2>/dev/null && (( n++ ))
        fi
      done
    done
    print "compiled $n file(s) -> .zwc"
  '
}

# needs_stow — true (0) if any managed target is missing or not our symlink.
needs_stow() {
  local pkg rel target resolved
  for pkg in "$STOW_DIR"/*/; do
    pkg="${pkg%/}"; pkg="${pkg##*/}"
    [ -d "$STOW_DIR/$pkg" ] || continue
    while IFS= read -r rel; do
      rel="${rel#./}"; target="$HOME/$rel"
      if [ -L "$target" ]; then
        resolved="$(readlink -f "$target" 2>/dev/null || true)"
        case "$resolved" in "$STOW_DIR/$pkg/"*) ;; *) return 0 ;; esac
      elif [ ! -e "$target" ]; then
        return 0
      fi
    done < <(cd "$STOW_DIR/$pkg" && find . -mindepth 1 \( -type f -o -type l \) 2>/dev/null)
  done
  return 1
}

cmd_stow() {
  local step="$DOTFILES_DIR/install/steps/stow-dotfiles.sh"
  [ -r "$step" ] || die "stow: missing $step"
  if [ "${1:-}" = "--if-needed" ]; then
    needs_stow || return 0
  fi
  bash "$step"
}

cmd_doctor() {
  local ok=0 bad=0 tb
  for tb in "$DOTFILES_DIR/var/tools/bin"; do
    [ -d "$tb" ] && case ":$PATH:" in *":$tb:"*) ;; *) PATH="$tb:$PATH" ;; esac
  done
  chk() { if eval "$2" >/dev/null 2>&1; then printf '  %s✔%s %s\n' "$c_on" "$c_r" "$1"; ok=$((ok+1)); else printf '  %s✘%s %s\n' "$c_off" "$c_r" "$1"; bad=$((bad+1)); fi; }

  printf '%spaths%s\n' "$c_b" "$c_r"
  chk "DOTFILES_DIR exists ($DOTFILES_DIR)"   "[ -d '$DOTFILES_DIR' ]"
  chk "shell framework present"               "[ -r '$SHELL_DIR/loader.sh' ]"
  chk "ZDOTDIR config present"                "[ -r '$DOTFILES_DIR/config/zsh/.zshrc' ]"
  chk "ZDOTDIR .zprofile present"             "[ -r '$DOTFILES_DIR/config/zsh/.zprofile' ]"
  chk "~/.zshenv -> repo bootstrap"           "[ -L \"\$HOME/.zshenv\" ]"
  chk "var/tools/bin populated"               "[ -d '$DOTFILES_DIR/var/tools/bin' ]"
  chk "var/vendor populated"                  "[ -d '$DOTFILES_DIR/var/vendor' ]"
  chk "zsh-defer present"                     "[ -r '$DOTFILES_DIR/var/vendor/zsh-defer/zsh-defer.plugin.zsh' ]"

  printf '%score tools%s\n' "$c_b" "$c_r"
  local t
  for t in zsh starship sheldon fzf atuin zoxide eza bat rg fd; do
    chk "$t on PATH" "command -v $t"
  done

  printf '%sstow symlinks%s\n' "$c_b" "$c_r"
  if needs_stow; then
    printf '  %s✘%s some targets unstowed — run: dotfiles stow\n' "$c_off" "$c_r"; bad=$((bad+1))
  else
    printf '  %s✔%s all stow targets linked\n' "$c_on" "$c_r"; ok=$((ok+1))
  fi

  printf '\n%d ok, %d issue(s)\n' "$ok" "$bad"
}

# Lint everything: shellcheck for POSIX/bash (.sh) scripts, and `zsh -n`
# (parse/syntax check) for zsh files — shellcheck does not support zsh, so
# `zsh -n` is the practical zsh linter (and `dotfiles compile` catches more).
cmd_check() {
  local rc=0 f any=0

  # 1) shellcheck — .sh scripts + the bash CLI + the portable shrc base.
  if command -v shellcheck >/dev/null 2>&1; then
    any=1
    local sh=()
    while IFS= read -r f; do sh+=("$f"); done < <(
      find "$DOTFILES_DIR/install" "$SHELL_DIR" -type f -name '*.sh' 2>/dev/null)
    [ -r "$SHELL_DIR/shrc" ] && sh+=("$SHELL_DIR/shrc")
    printf '%s==>%s shellcheck (%d sh files + bin/dotfiles)\n' "$c_b" "$c_r" "${#sh[@]}"
    if shellcheck -x "$DOTFILES_DIR/bin/dotfiles" "${sh[@]}"; then
      printf '  %s✔%s shellcheck clean\n' "$c_on" "$c_r"
    else rc=1; fi
  else
    printf '  %s!%s shellcheck not found — skipping .sh lint (run ./install.sh)\n' "$c_off" "$c_r"
  fi

  # 2) collect the zsh files (modules, autoloaded functions, completions, the
  #    config/zsh entrypoints, and the ~/.zshenv bootstrap).
  local zf=() base
  while IFS= read -r f; do
    base=${f##*/}; case "$base" in .gitkeep|*.zwc|*.md) continue ;; esac
    [ -r "$f" ] && zf+=("$f")
  done < <(
    find "$SHELL_DIR/zsh" "$SHELL_DIR/functions" "$SHELL_DIR/completions" \
         "$DOTFILES_DIR/config/zsh" -type f 2>/dev/null
    printf '%s\n' "$DOTFILES_DIR/config/stow/home/.zshenv")

  # 2a) zsh -n parse check (always available when zsh is) — the floor.
  if command -v zsh >/dev/null 2>&1; then
    any=1; local bad=0
    printf '%s==>%s zsh -n (%d zsh files)\n' "$c_b" "$c_r" "${#zf[@]}"
    for f in "${zf[@]}"; do
      if ! zsh -n "$f" 2>&1; then printf '  %s✘%s %s\n' "$c_off" "$c_r" "$f"; bad=1; rc=1; fi
    done
    [ "$bad" -eq 0 ] && printf '  %s✔%s zsh -n clean\n' "$c_on" "$c_r"
  fi

  # 2b) zshellcheck static analysis (shellcheck has no zsh support).
  if command -v zshellcheck >/dev/null 2>&1; then
    any=1
    printf '%s==>%s zshellcheck (%d zsh files)\n' "$c_b" "$c_r" "${#zf[@]}"
    if zshellcheck "${zf[@]}"; then printf '  %s✔%s zshellcheck clean\n' "$c_on" "$c_r"; else rc=1; fi
  else
    printf '  %s!%s zshellcheck not found — skipping zsh static analysis (run ./install.sh)\n' "$c_off" "$c_r"
  fi

  # 3) actionlint — GitHub workflow YAML.
  if command -v actionlint >/dev/null 2>&1 && [ -d "$DOTFILES_DIR/.github/workflows" ]; then
    any=1
    printf '%s==>%s actionlint\n' "$c_b" "$c_r"
    if actionlint -color=false "$DOTFILES_DIR"/.github/workflows/*.y*ml; then
      printf '  %s✔%s actionlint clean\n' "$c_on" "$c_r"; else rc=1; fi
  fi

  # 4) editorconfig-checker — files vs .editorconfig (excludes via .ecrc).
  if command -v editorconfig-checker >/dev/null 2>&1; then
    any=1
    printf '%s==>%s editorconfig-checker\n' "$c_b" "$c_r"
    if ( cd "$DOTFILES_DIR" && editorconfig-checker ); then
      printf '  %s✔%s editorconfig clean\n' "$c_on" "$c_r"; else rc=1; fi
  fi

  [ "$any" -eq 1 ] || die "check: no linters available (run ./install.sh)"
  return $rc
}

# Scan the working tree for committed secrets with betterleaks.
cmd_audit() {
  command -v betterleaks >/dev/null 2>&1 || die "audit: betterleaks not found (run ./install.sh)"
  printf '%s==>%s betterleaks dir (working tree)\n' "$c_b" "$c_r"
  ( cd "$DOTFILES_DIR" && betterleaks dir . -v )
}

cmd_test() {
  command -v bats >/dev/null 2>&1 || die "test: bats not found (install bats-core)"
  [ -d "$DOTFILES_DIR/test" ] || die "test: no test/ dir"
  bats "$DOTFILES_DIR/test"
}

cmd_bench() {
  command -v zsh >/dev/null 2>&1 || die "bench: zsh not found"
  local n="${1:-10}" i s e t total=0
  echo "Benchmarking $n interactive zsh startups (zsh -i -c exit)…"
  for i in $(seq 1 "$n"); do
    s="$(date +%s.%N)"; zsh -i -c exit </dev/null >/dev/null 2>&1; e="$(date +%s.%N)"
    t="$(awk "BEGIN{print ($e-$s)*1000}")"
    total="$(awk "BEGIN{print $total+$t}")"
    printf '  run %2d: %7.1f ms\n' "$i" "$t"
  done
  awk "BEGIN{printf \"  ----\n  avg:   %7.1f ms over %d run(s)\n\", $total/$n, $n}"
}

cmd_profile() {
  command -v zsh >/dev/null 2>&1 || die "profile: zsh not found"
  echo "Starting a profiled interactive zsh (exit it to return)..."
  DOTFILES_PROFILE=1 zsh -i -l
}

# --- man page generation (from _commands, so it never drifts) ----------------
_gen_man() {
  local out="$DOTFILES_DIR/man/dotfiles.1" date
  date="$(date +%Y-%m-%d)"
  mkdir -p "${out%/*}"
  {
    printf '.TH DOTFILES 1 "%s" "dotfiles" "Dotfiles Manual"\n' "$date"
    printf '.SH NAME\ndotfiles \\- manage the dotfiles shell framework\n'
    printf '.SH SYNOPSIS\n.B dotfiles\n.RI [ command ] " " [ args ...]\n'
    printf '.SH DESCRIPTION\n'
    printf 'Manage a stow-based, ZDOTDIR shell framework: toggle modules, (re)create\n'
    printf 'symlinks, byte-compile for speed, run health checks, lint, test and benchmark.\n'
    printf '.SH COMMANDS\n'
    local name desc
    while IFS=$'\t' read -r name desc; do
      [ -n "$name" ] || continue
      printf '.TP\n.B %s\n%s\n' "$name" "$desc"
    done < <(_commands)
    printf '.SH FILES\n'
    printf '.TP\n.B $DOTFILES_DIR/config/zsh\nZDOTDIR: zsh startup files.\n'
    printf '.TP\n.B $DOTFILES_DIR/var\nGenerated, gitignored tools/plugins/cache.\n'
    printf '.TP\n.B $DOTFILES_LOCAL/profile\n'
    printf 'Semantic drop-ins: secrets login aliases tools company (.sh). Only\n'
    printf 'profile.example/ templates are tracked; your profile/*.sh are gitignored.\n'
    printf '.TP\n.B $DOTFILES_LOCAL/disabled\nPersisted module toggles (dotfiles disable).\n'
    printf '.SH SEE ALSO\nstow(8), zsh(1), starship(1), sheldon(1)\n'
  } > "$out"
  echo "wrote $out"
}

cmd_doc() {
  case "${1:-man}" in
    man|all) _gen_man ;;
    *) die "doc: unknown target '$1' (try: man)" ;;
  esac
}

usage() {
  printf '%sdotfiles%s — manage this dotfiles framework\n\n' "$c_b" "$c_r"
  printf 'usage: dotfiles <command> [args]\n\n'
  local name desc
  while IFS=$'\t' read -r name desc; do
    [ -n "$name" ] || continue
    printf '  %s%-20s%s %s\n' "$c_on" "$name" "$c_r" "$desc"
  done < <(_commands)
}

main() {
  local sub="${1:-help}"; shift || true
  case "$sub" in
    list)            cmd_list "$@" ;;
    enable)          cmd_enable "$@" ;;
    disable)         cmd_disable "$@" ;;
    reload)          cmd_reload "$@" ;;
    compile)         cmd_compile "$@" ;;
    stow)            cmd_stow "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    check)           cmd_check "$@" ;;
    audit)           cmd_audit "$@" ;;
    test)            cmd_test "$@" ;;
    bench)           cmd_bench "$@" ;;
    update)          cmd_update "$@" ;;
    profile)         cmd_profile "$@" ;;
    doc)             cmd_doc "$@" ;;
    help|-h|--help)  usage ;;
    *)               die "unknown command '$sub' (try: dotfiles help)" ;;
  esac
}

cmd_update() {
  command -v git >/dev/null 2>&1 || die "update: git not found"
  echo "==> git pull --ff-only ($DOTFILES_DIR)"
  git -C "$DOTFILES_DIR" pull --ff-only || die "update: pull failed (resolve manually)"
  echo "==> ./install.sh"
  "$DOTFILES_DIR/install.sh" "$@"
}

main "$@"
