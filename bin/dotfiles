#!/usr/bin/env bash
# dotfiles — chezmoi-backed shell framework CLI. See: dotfiles help
set -uo pipefail

self="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-${self%/bin}}"
SHELL_DIR="$DOTFILES_DIR/config/shell"
LOCAL_DIR="${DOTFILES_LOCAL:-$DOTFILES_DIR/local}"
DISABLED_FILE="$LOCAL_DIR/disabled"
AQUA_ROOT_DIR="${AQUA_ROOT_DIR:-$DOTFILES_DIR/var/tools/aqua}"
TOOLS_BIN="$DOTFILES_DIR/var/tools/bin"
# Prefer legacy/musl tools (chezmoi) over aqua shims; aqua still on PATH for other CLIs.
case ":$PATH:" in *":$AQUA_ROOT_DIR/bin:"*) ;; *) PATH="$AQUA_ROOT_DIR/bin:$PATH" ;; esac
case ":$PATH:" in *":$TOOLS_BIN:"*) ;; *) PATH="$TOOLS_BIN:$PATH" ;; esac
export PATH AQUA_ROOT_DIR DOTFILES_DIR TOOLS_BIN

c_on=$'\033[1;32m'
c_off=$'\033[1;33m'
c_b=$'\033[1;34m'
c_r=$'\033[0m'
[ -t 1 ] || {
  c_on=
  c_off=
  c_b=
  c_r=
}
die() {
  printf 'dotfiles: %s\n' "$*" >&2
  exit 1
}
_msg_ok() { printf '  %s✔%s %s\n' "$c_on" "$c_r" "$*"; }

_commands() {
  cat <<'EOF'
list	list modules and their on/off state
enable <name>...	re-enable module(s) (persists)
disable <name>...	disable module(s) (persists)
reload	recompile, then re-exec the current shell
update	git pull --ff-only, then re-run install.sh
update-tools [--with-optional]	install/update tools (aqua + legacy)
apply [--if-needed]	apply $HOME files via chezmoi (alias: stow)
diff	show chezmoi diff vs $HOME
status	show chezmoi managed file status
vnc <cmd> [args]	TigerVNC: start|stop|status|enable|disable
ssh <cmd> [args]	SSH: add|edit|list|sync|migrate
profile <cmd> [args]	local/profile: add|edit|list|init
profile-init	alias for: dotfiles profile init
stow [--if-needed]	alias for: dotfiles apply
jira|gitlab|secrets|bugwarrior|invite	productivity tools
compile	byte-compile zsh framework (.zwc)
doctor	health checks
doctor-tools	tool versions and hooks
validate	configuration integrity
check	lint scripts
audit	secret scan (betterleaks)
test	bats smoke tests
bench [N]	startup benchmark
startup-profile [--sort]	per-module startup timing
doc [man]	regenerate man page
help	show this help
EOF
}

_modname() {
  local b=${1##*/}
  b=${b%.*}
  case "$b" in [0-9][0-9]-*) b=${b#??-} ;; esac
  printf '%s\n' "$b"
}
_is_disabled() { [ -r "$DISABLED_FILE" ] && grep -qxF "$1" "$DISABLED_FILE"; }

# --- chezmoi backend ---------------------------------------------------------
# RHEL 8 / glibc 2.28: aqua's standard chezmoi is glibc-linked (needs 2.32+) and
# aborts. Always prefer the musl build from install/tools/chezmoi.sh.
_chezmoi_usable() {
  local b=$1 out
  [ -x "$b" ] || return 1
  # Never use aqua-proxy for chezmoi (resolves to glibc build).
  if [ -L "$b" ]; then
    case "$(readlink "$b" 2>/dev/null || true)" in *aqua-proxy*) return 1 ;; esac
  fi
  out="$("$b" --version 2>&1)" || return 1
  case "$out" in *GLIBC_*) return 1 ;; esac
  return 0
}

_chezmoi_bin() {
  local tb
  for tb in "$TOOLS_BIN/chezmoi" "$(command -v chezmoi 2>/dev/null || true)"; do
    [ -n "$tb" ] || continue
    _chezmoi_usable "$tb" && return 0
  done
  return 1
}

CHEZMOI_SOURCE="$DOTFILES_DIR/home"
CHEZMOI_CONFIG="$CHEZMOI_SOURCE/.chezmoi.toml"

_chezmoi() {
  local bin="" cand
  for cand in "$TOOLS_BIN/chezmoi" "$(command -v chezmoi 2>/dev/null || true)"; do
    [ -n "$cand" ] || continue
    if _chezmoi_usable "$cand"; then
      bin="$cand"
      break
    fi
  done
  if [ -z "$bin" ]; then
    die "chezmoi missing or glibc-incompatible — run: bash install/tools/chezmoi.sh"
  fi
  [ -d "$CHEZMOI_SOURCE" ] || die "missing chezmoi source: $CHEZMOI_SOURCE"
  [ -f "$CHEZMOI_CONFIG" ] || die "missing chezmoi config: $CHEZMOI_CONFIG"
  mkdir -p "$DOTFILES_DIR/var/cache"
  "$bin" --persistent-state "$DOTFILES_DIR/var/cache/chezmoi-state.json" \
    --config "$CHEZMOI_CONFIG" \
    --source "$CHEZMOI_SOURCE" "$@"
}

_stage_local_data() {
  local src="$LOCAL_DIR/data" dst="$CHEZMOI_SOURCE/.chezmoidata"
  mkdir -p "$dst"
  [ -d "$src" ] && for f in "$src"/*.toml; do
    [ -f "$f" ] || continue
    cp "$f" "$dst/local_${f##*/}"
  done
  local ssh="$LOCAL_DIR/profile/ssh.local" ssh_dest="$CHEZMOI_SOURCE/dot_ssh/config.d/local.conf"
  if [ -f "$ssh" ]; then
    cp "$ssh" "$ssh_dest"
  elif [ ! -s "$ssh_dest" ]; then
    printf '%s\n' '# Machine-specific SSH — dotfiles ssh add|edit' >"$ssh_dest"
  fi
}

_cleanup_local_data() { rm -f "$CHEZMOI_SOURCE"/.chezmoidata/local_*.toml 2>/dev/null || true; }

needs_apply() {
  local out
  out="$(_chezmoi status --path-style=relative 2>/dev/null || true)"
  [ -n "$out" ]
}

cmd_apply() {
  local if_needed=0
  [ "${1:-}" = "--if-needed" ] && {
    if_needed=1
    shift || true
  }
  if [ "$if_needed" -eq 1 ] && ! needs_apply; then return 0; fi
  _stage_local_data
  printf '%s==>%s chezmoi apply\n' "$c_b" "$c_r"
  _chezmoi apply "$@" || {
    _cleanup_local_data
    die "apply failed"
  }
  _cleanup_local_data
  _msg_ok "applied to \$HOME"
}

cmd_diff() {
  _stage_local_data
  _chezmoi diff "$@" || true
  _cleanup_local_data
}
cmd_status() {
  _stage_local_data
  _chezmoi status "$@"
  _cleanup_local_data
}
cmd_stow() { cmd_apply "$@"; }

# --- modules -----------------------------------------------------------------
cmd_list() {
  local d f name profile_dir="$LOCAL_DIR/profile"
  for d in "$SHELL_DIR/zsh" "$SHELL_DIR/tools" "$SHELL_DIR/tools/init"; do
    [ -d "$d" ] || continue
    printf '%s%s%s\n' "$c_b" "${d#"$DOTFILES_DIR/"}" "$c_r"
    for f in "$d"/*.sh "$d"/*.zsh; do
      [ -r "$f" ] || continue
      case "${f##*/}" in *.example | README* | disabled) continue ;; esac
      name="$(_modname "$f")"
      if _is_disabled "$name"; then
        printf '  %soff%s  %s\n' "$c_off" "$c_r" "$name"
      else printf '  %s on%s  %s\n' "$c_on" "$c_r" "$name"; fi
    done
  done
  [ -d "$profile_dir" ] && printf '%s%s%s\n' "$c_b" "${profile_dir#"$DOTFILES_DIR/"}" "$c_r"
  for f in "$profile_dir"/*; do
    [ -f "$f" ] || continue
    name="${f##*/}"
    case "$name" in .gitignore | README.md | secrets.sh) continue ;; esac
    printf '  %s on%s  %s\n' "$c_on" "$c_r" "$name"
  done
}

cmd_disable() {
  [ "$#" -gt 0 ] || die "disable: need module name"
  mkdir -p "$LOCAL_DIR"
  touch "$DISABLED_FILE"
  local m tmp
  tmp="$(mktemp)"
  for m in "$@"; do
    grep -qxF "$m" "$DISABLED_FILE" || printf '%s\n' "$m" >>"$DISABLED_FILE"
    echo "disabled: $m"
  done
  rm -f "$tmp" 2>/dev/null
  echo "Run: dotfiles reload"
}

cmd_enable() {
  [ "$#" -gt 0 ] || die "enable: need module name"
  [ -r "$DISABLED_FILE" ] || return 0
  local m tmp
  tmp="$(mktemp)"
  for m in "$@"; do
    grep -vxF "$m" "$DISABLED_FILE" >"$tmp" && mv "$tmp" "$DISABLED_FILE"
    echo "enabled: $m"
  done
  rm -f "$tmp" 2>/dev/null
  echo "Run: dotfiles reload"
}

cmd_reload() {
  command -v dotfiles >/dev/null 2>&1 && dotfiles compile >/dev/null 2>&1 || true
  local zsh_bin="$DOTFILES_DIR/var/tools/bin/zsh"
  [ -x "$zsh_bin" ] || zsh_bin="${SHELL:-$(command -v zsh 2>/dev/null || echo zsh)}"
  exec "$zsh_bin" -l
}

cmd_compile() {
  command -v zsh >/dev/null 2>&1 || die "compile: zsh not found"
  zsh -f -c '
    dirs=( "'"$SHELL_DIR"'"/zsh "'"$SHELL_DIR"'"/tools "'"$SHELL_DIR"'"/tools/init "'"$LOCAL_DIR"'"/profile )
    n=0
    for d in $dirs; do
      [[ -d $d ]] || continue
      for f in $d/*.zsh(N) $d/*.sh(N); do
        [[ -r $f ]] || continue
        if [[ ! -e $f.zwc || $f -nt $f.zwc ]]; then zcompile -- $f 2>/dev/null && (( n++ )); fi
      done
    done
    print "compiled $n file(s)"
  '
}

# --- profile -----------------------------------------------------------------
_PROFILE_FILES=(local.sh login.sh aliases.sh tools.sh company.sh ssh.local vnc.local)

_profile_path() { printf '%s/profile/%s' "$LOCAL_DIR" "$1"; }

_profile_template() {
  local name="$1" tpl="$DOTFILES_DIR/config/templates/profile/$name"
  if [ -r "$tpl" ]; then
    cat "$tpl"
    return
  fi
  case "$name" in
    *.sh) printf '# %s — edit for your machine\n' "$name" ;;
    ssh.local) printf '# Host example\n#   HostName 10.0.0.1\n' ;;
    vnc.local) printf '# export VNC_DISPLAY=2\n' ;;
    *) printf '# %s\n' "$name" ;;
  esac
}

cmd_profile_add() {
  local name="${1:-}"
  [ -n "$name" ] || die "profile add: need file name"
  local path="$(_profile_path "$name")"
  mkdir -p "$(dirname "$path")"
  [ -e "$path" ] && die "profile add: $path exists — use: dotfiles profile edit $name"
  _profile_template "$name" >"$path"
  _msg_ok "created $path"
}

cmd_profile_edit() {
  local name="${1:-}" editor
  [ -n "$name" ] || die "profile edit: need file name"
  local path="$(_profile_path "$name")"
  [ ! -f "$path" ] && cmd_profile_add "$name"
  editor="${EDITOR:-vim}"
  command -v "$editor" >/dev/null 2>&1 || die "editor $editor not found"
  "$editor" "$path"
  case "$name" in ssh.local | vnc.local) cmd_apply ;; esac
}

cmd_profile_list() {
  printf '%slocal/profile%s\n' "$c_b" "$c_r"
  local f
  for f in "$LOCAL_DIR/profile"/*; do
    [ -f "$f" ] || continue
    printf '  %s\n' "${f##*/}"
  done
}

cmd_profile_init() {
  mkdir -p "$LOCAL_DIR/profile"
  local name path created=0
  for name in "${_PROFILE_FILES[@]}"; do
    path="$(_profile_path "$name")"
    [ -e "$path" ] && continue
    _profile_template "$name" >"$path"
    _msg_ok "created $path"
    created=$((created + 1))
  done
  bash "$DOTFILES_DIR/install/steps/migrate-ssh-profile.sh" 2>/dev/null || true
  cmd_apply
  if [ "$created" -eq 0 ]; then
    _msg_ok "profile init done (all files already existed)"
  else
    _msg_ok "profile init done ($created file(s) created)"
  fi
}

cmd_profile() {
  local sub="${1:-list}"
  shift || true
  case "$sub" in
    add) cmd_profile_add "$@" ;;
    edit) cmd_profile_edit "$@" ;;
    list) cmd_profile_list "$@" ;;
    init) cmd_profile_init "$@" ;;
    help | -h | --help)
      cat <<'EOF'
usage: dotfiles profile add|edit|list|init
EOF
      ;;
    *) die "profile: unknown command $sub" ;;
  esac
}

# --- ssh ---------------------------------------------------------------------
cmd_ssh_list() {
  local f="$LOCAL_DIR/profile/ssh.local"
  [ -r "$f" ] || die "no ssh.local — run: dotfiles profile add ssh.local"
  awk '/^Host / {print "  " $2}' "$f"
}

cmd_ssh_edit() {
  local f="$LOCAL_DIR/profile/ssh.local" e="${EDITOR:-vim}"
  mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || touch "$f"
  "$e" "$f"
  cmd_apply
}

cmd_ssh_add() {
  local alias="${1:-}"
  shift || true
  local hostname="" user="" forward=""
  [ -n "$alias" ] || die "ssh add: need alias"
  while [ $# -gt 0 ]; do
    case "$1" in
      -H | --hostname)
        hostname="$2"
        shift 2
        ;;
      -u | --user)
        user="$2"
        shift 2
        ;;
      -F | --forward)
        forward="$2"
        shift 2
        ;;
      *) die "ssh add: unknown option $1" ;;
    esac
  done
  local f="$LOCAL_DIR/profile/ssh.local"
  mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || touch "$f"
  grep -qE "^Host[[:space:]]+${alias}([[:space:]]|$)" "$f" && die "Host $alias exists"
  {
    printf '\nHost %s\n' "$alias"
    [ -n "$hostname" ] && printf '  HostName %s\n' "$hostname"
    [ -n "$user" ] && printf '  User %s\n' "$user"
    if [ -n "$forward" ]; then
      local lp="${forward%%:*}" rp="${forward#*:}"
      [ "$rp" = "$forward" ] && rp="$lp"
      printf '  LocalForward %s 127.0.0.1:%s\n' "$lp" "$rp"
    fi
  } >>"$f"
  cmd_apply
}

cmd_ssh_migrate() {
  bash "$DOTFILES_DIR/install/steps/migrate-ssh-profile.sh"
}

cmd_ssh() {
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    add) cmd_ssh_add "$@" ;;
    edit) cmd_ssh_edit "$@" ;;
    list) cmd_ssh_list "$@" ;;
    sync) cmd_apply "$@" ;;
    migrate) cmd_ssh_migrate "$@" ;;
    help | -h | --help)
      cat <<'EOF'
usage: dotfiles ssh add|edit|list|sync|migrate
EOF
      ;;
    *) die "ssh: unknown command $sub" ;;
  esac
}

# --- vnc (systemd user unit + vncserver fallback) -----------------------------
cmd_vnc() {
  local cmd="${1:-start}"
  shift || true
  local disp="${VNC_DISPLAY:-2}" geometry="" unit="vncserver@:${disp}.service"
  [ -r "$LOCAL_DIR/profile/vnc.local" ] && source "$LOCAL_DIR/profile/vnc.local"
  case "$cmd" in
    -h | --help | help)
      cat <<'EOF'
usage: dotfiles vnc start|stop|status|enable|disable [display] [-g WxH]
EOF
      return 0
      ;;
    start | stop | status | enable | disable) ;;
    *)
      disp="$cmd"
      cmd=start
      ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      -g | --geometry)
        geometry="$2"
        shift 2
        ;;
      -*) die "vnc: unknown option $1" ;;
      *)
        disp="$1"
        shift
        ;;
    esac
  done
  geometry="${geometry:-${VNC_GEOMETRY:-}}"
  local envf="$HOME/.vnc/vncserver.env"
  if [ -n "$geometry" ]; then
    mkdir -p "$HOME/.vnc"
    printf 'VNC_EXTRA_ARGS=-geometry %s\n' "$geometry" >"$envf"
  elif [ -f "$envf" ]; then rm -f "$envf"; fi
  unit="vncserver@:${disp}.service"
  if [ "${VNC_USE_SYSTEMD:-1}" != 0 ] && systemctl --user show -p LoadState --value default.target &>/dev/null; then
    case "$cmd" in
      start)
        systemctl --user daemon-reload
        systemctl --user start "$unit"
        ;;
      stop) systemctl --user stop "$unit" ;;
      status) systemctl --user status "$unit" ;;
      enable)
        systemctl --user enable "$unit"
        loginctl enable-linger "$USER" 2>/dev/null || true
        ;;
      disable) systemctl --user disable "$unit" ;;
    esac
    return
  fi
  case "$cmd" in
    start) vncserver ":$disp" -noreset ${geometry:+-geometry "$geometry"} ;;
    stop) vncserver -kill ":$disp" ;;
    status) vncserver -list ;;
    enable) die "vnc enable: needs user systemd" ;;
    disable) die "vnc disable: needs user systemd" ;;
  esac
}

# --- doctor (abbreviated) ----------------------------------------------------
cmd_doctor() {
  local ok=0 bad=0
  chk() { if eval "$2" >/dev/null 2>&1; then
    printf '  %s✔%s %s\n' "$c_on" "$c_r" "$1"
    ok=$((ok + 1))
  else
    printf '  %s✘%s %s\n' "$c_off" "$c_r" "$1"
    bad=$((bad + 1))
  fi; }
  printf '%schezmoi / paths%s\n' "$c_b" "$c_r"
  chk "DOTFILES_DIR" "[ -d '$DOTFILES_DIR' ]"
  chk "home/ source tree" "[ -d '$DOTFILES_DIR/home' ]"
  chk "chezmoi installed" "_chezmoi_bin"
  chk "~/.zshenv present" "[ -f '$HOME/.zshenv' ]"
  if needs_apply; then
    printf '  %s✘%s pending changes — run: dotfiles apply\n' "$c_off" "$c_r"
    bad=$((bad + 1))
  else
    printf '  %s✔%s $HOME matches source\n' "$c_on" "$c_r"
    ok=$((ok + 1))
  fi
  printf '\n%d ok, %d issue(s)\n' "$ok" "$bad"
}

cmd_check() {
  local rc=0
  command -v shellcheck >/dev/null 2>&1 || die "shellcheck missing"
  shellcheck -x "$DOTFILES_DIR/bin/dotfiles" "$DOTFILES_DIR/install"/*.sh "$DOTFILES_DIR/install/steps"/*.sh || rc=1
  command -v zsh >/dev/null 2>&1 && find "$SHELL_DIR" "$DOTFILES_DIR/config/zsh" -name '*.zsh' -print0 |
    xargs -0 -r zsh -n || rc=1
  return $rc
}

cmd_audit() {
  command -v betterleaks >/dev/null 2>&1 || die "betterleaks missing"
  (cd "$DOTFILES_DIR" && betterleaks dir . -v)
}

cmd_test() {
  command -v bats >/dev/null 2>&1 || die "bats missing"
  bats "$DOTFILES_DIR/test"
}

cmd_bench() {
  local n="${1:-10}"
  if command -v hyperfine >/dev/null 2>&1; then
    hyperfine --warmup 3 --runs "$n" --shell=none 'zsh -i -c exit'
    return
  fi
  local i t
  for i in $(seq 1 "$n"); do zsh -i -c exit </dev/null; done
}

cmd_update() {
  git -C "$DOTFILES_DIR" pull --ff-only || die "pull failed"
  "$DOTFILES_DIR/install.sh" "$@"
}

cmd_update_tools() {
  # Prefer aqua (aqua.yaml); falls back to legacy scripts for non-registry tools.
  bash "$DOTFILES_DIR/install/steps/install-tools.sh" "$@"
}

_py() {
  exec "$DOTFILES_DIR/bin/dotfiles-run" -m dotfiles_tools "$@"
}

cmd_doc() {
  local out="$DOTFILES_DIR/man/dotfiles.1" date
  date="$(date +%Y-%m-%d)"
  {
    printf '.TH DOTFILES 1 "%s" "dotfiles" "Dotfiles Manual"\n' "$date"
    while IFS=$'\t' read -r n d; do [ -n "$n" ] && printf '.TP\n.B %s\n%s\n' "$n" "$d"; done < <(_commands)
  } >"$out"
  echo "wrote $out"
}

usage() {
  printf '%sdotfiles%s — chezmoi-backed shell framework\n\nusage: dotfiles <command>\n\n' "$c_b" "$c_r"
  local n d
  while IFS=$'\t' read -r n d; do [ -n "$n" ] && printf '  %s%-18s%s %s\n' "$c_on" "$n" "$c_r" "$d"; done < <(_commands)
}

main() {
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    list) cmd_list "$@" ;; enable) cmd_enable "$@" ;; disable) cmd_disable "$@" ;;
    reload) cmd_reload "$@" ;; compile) cmd_compile "$@" ;;
    apply | stow) cmd_apply "$@" ;; diff) cmd_diff "$@" ;; status) cmd_status "$@" ;;
    vnc) cmd_vnc "$@" ;; ssh) cmd_ssh "$@" ;;
    profile) cmd_profile "$@" ;; profile-init) cmd_profile_init "$@" ;;
    doctor) cmd_doctor "$@" ;; doctor-tools) "$DOTFILES_DIR/bin/dotfiles-tools" doctor ;;
    validate) "$DOTFILES_DIR/bin/dotfiles-validate" config ;;
    check) cmd_check "$@" ;; audit) cmd_audit "$@" ;; test) cmd_test "$@" ;;
    bench) cmd_bench "$@" ;; startup-profile) "$DOTFILES_DIR/bin/dotfiles-profile" "$@" ;;
    update) cmd_update "$@" ;; update-tools) cmd_update_tools "$@" ;;
    jira) _py jira "$@" ;; gitlab) _py gitlab "$@" ;; secrets) _py secrets "$@" ;;
    bugwarrior) _py bugwarrior "$@" ;; invite) _py invite "$@" ;;
    doc) cmd_doc "$@" ;; help | -h | --help) usage ;;
    *) die "unknown command '$sub'" ;;
  esac
}

main "$@"
